{
  "manifest_version": 3,
  "name": "ChatGPT Session Dispatcher",
  "version": "0.1.1",
  "description": "Explicitly connect selected ChatGPT conversations to a private HTTPS task dispatcher.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://csd.guddom.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Session Dispatcher"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}